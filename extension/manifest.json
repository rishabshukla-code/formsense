{
  "manifest_version": 3,
  "name": "FormSense",
  "version": "0.3.0",
  "description": "A voice copilot that explains the form you're filling in.",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open FormSense" },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/practice*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
